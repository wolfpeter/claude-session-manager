# Copy to .env (in the repo root) and adjust.
PORT=31415
HOST=0.0.0.0
# Command started inside each new tmux session (executed by the login shell, no arguments interpolation)
CLAUDE_COMMAND=claude
# Only tmux sessions whose name starts with this prefix are shown/managed
SESSION_PREFIX=claude-
# Colon-separated list of directories from which sessions may be started
ALLOWED_DIRECTORIES=/home/user/projects
# Optional: if set, every API/WS request must carry this token (?token=... or X-Api-Key header)
AUTH_TOKEN=
# Number of scrollback lines sent to the browser on (re)connect
HISTORY_LINES=200
# A session that looks busy but produced no output for this many seconds is shown as "May be stuck"
STALL_SECONDS=120
# Pass the application's mouse reporting to the browser. Off means a drag selects text (and can be
# copied); on means the drag goes to Claude, so you can click its UI but need Shift to select.
BROWSER_MOUSE_REPORTING=off
LOG_LEVEL=info
